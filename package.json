{
  "name": "ai-quota-dashboard",
  "version": "0.2.0",
  "type": "module",
  "description": "Local CLI + Harness plugin for AI subscription quotas, reading already-signed-in console pages through CDP.",
  "license": "MIT",
  "author": "Joe Pan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panyz/ai-quota-dashboard.git"
  },
  "homepage": "https://github.com/panyz/ai-quota-dashboard#readme",
  "bugs": {
    "url": "https://github.com/panyz/ai-quota-dashboard/issues"
  },
  "keywords": [
    "ai",
    "quota",
    "usage",
    "dashboard",
    "cli",
    "cdp",
    "claude",
    "codex",
    "deepseek",
    "zhipu",
    "opencode",
    "grok",
    "dsh"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": { "quota": "./bin/quota.js" },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/**",
    "bin/**"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "quota": "node bin/quota.js"
  }
}
